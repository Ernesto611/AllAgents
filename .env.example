# =====================================================================
#  AllAgents — configuración
#  1. Copia este archivo:   cp .env.example .env   (setup.sh lo hace por ti)
#  2. Protégelo:            chmod 600 .env
#  3. Rellena SOLO lo que tengas. Todo es opcional: un agente sin clave,
#     sin CLI instalado o sin servicio corriendo simplemente no se publica.
#  Comprueba el resultado con:  .venv/bin/allagents check
#  El servidor NO carga .env si otros usuarios pueden leerlo.
# =====================================================================

# ============================ PRIORIDADES ============================
# Orden en que Claude prefiere los agentes (el primero que sirva para la
# tarea). Vacío = orden por defecto:
#   ollama, groq, mistral, cohere, agy, opencode, codex, deepseek, copilot
# Puedes listar solo algunos: los que no aparezcan van detrás.
ALLAGENTS_PRIORITY=

# Agentes a desactivar aunque estén configurados (separados por comas).
# Copilot va desactivado por defecto: su confinamiento no está verificado.
ALLAGENTS_DISABLE=copilot

# ====================== 1) LOCAL · ILIMITADO =========================
# Ollama — https://ollama.com  (instálalo y descarga los modelos con
# `ollama pull qwen3-coder:30b` y `ollama pull qwen2.5-coder:7b`)
# Solo se aceptan direcciones locales (127.0.0.1 / localhost / ::1).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_FAST_MODEL=qwen2.5-coder:7b
# Contexto en tokens (más contexto = más RAM/VRAM)
OLLAMA_NUM_CTX=16384

# ===================== 2) GRATIS CON LÍMITES =========================
# Groq — https://console.groq.com/keys
GROQ_API_KEY=
# qwen3.8-27b: el más rápido y el que menos tokens gasta.
# Más calidad: openai/gpt-oss-120b. (Groq ya no ofrece Llama ni Mixtral.)
GROQ_MODEL=qwen/qwen3.8-27b

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# (Opcional) clave de Codestral — https://codestral.mistral.ai
# Si está definida, se usa el endpoint de Codestral con esta clave.
CODESTRAL_API_KEY=
MISTRAL_MODEL=codestral-latest

# Cohere — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# Command R (128k). Más contexto: command-a-03-2025 (256k)
COHERE_MODEL=command-r-08-2024

# OpenCode Zen (modelos gratuitos) — https://opencode.ai/auth
# Cupo gratuito MUY bajo y compartido entre todos los modelos gratuitos.
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash-free

# =================== SUSCRIPCIONES (vía su CLI) ======================
# Se usa la sesión que ya tengas iniciada en cada CLI; no lleva clave aquí.
# Vacío = buscar el ejecutable en el PATH.
# Google Antigravity (agy): inicia sesión una vez con `agy`
AGY_BIN=
AGY_MODEL=gemini-3.8-flash-medium
# OpenAI Codex con tu cuenta de ChatGPT: `npm i -g @openai/codex && codex login`
CODEX_BIN=
# Vacío = el modelo por defecto de tu cuenta
CODEX_MODEL=
# GitHub Copilot CLI: `npm i -g @github/copilot` (requiere un plan que incluya el CLI)
COPILOT_BIN=
COPILOT_MODEL=

# ========================== PAGO POR USO =============================
# DeepSeek — https://platform.deepseek.com/api_keys  (datos en China)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ============== AGENTES PERSONALIZADOS (sin escribir código) =========
# Cualquier API compatible con OpenAI (OpenRouter, Together, xAI, LM Studio,
# vLLM…). Declara nombres en ALLAGENTS_CUSTOM y, por cada uno, sus variables
# con el nombre en MAYÚSCULAS como prefijo. Crea la herramienta ask_<nombre>.
#   <N>_BASE_URL     obligatoria (https en la nube; loopback si <N>_LOCAL=true)
#   <N>_MODEL        obligatoria
#   <N>_API_KEY      obligatoria en la nube
#   <N>_LOCAL        true solo si corre en esta máquina
#   <N>_ROLE         una línea para la lista de prioridades
#   <N>_DESCRIPTION  cuándo usarla y cuándo no (la lee Claude)
#   <N>_PRIORITY     número; menor = antes (por defecto 15 local, 65 nube)
#   <N>_TIER         etiqueta de coste (p. ej. "pago por uso")
ALLAGENTS_CUSTOM=
# Ejemplo (descomenta y añade "openrouter" a ALLAGENTS_CUSTOM):
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_ROLE=acceso a muchos modelos con una sola clave
# OPENROUTER_DESCRIPTION=OpenRouter. Úsala para probar modelos que no tenemos integrados.
# OPENROUTER_TIER=pago por uso

# ===================== ACCESO A ARCHIVOS (files) =====================
# Carpetas desde las que se pueden enviar archivos a los agentes
# (separadas por ":"). Todo lo que esté fuera se rechaza.
ALLAGENTS_ALLOWED_DIRS=~/Documentos:~/Documents
# Carpetas con datos sensibles: sus archivos SOLO se envían a agentes
# locales; cualquier agente en la nube los rechaza. Ej.:
# ALLAGENTS_LOCAL_ONLY_DIRS=~/Documentos/Layouts:~/Documentos/Clientes
ALLAGENTS_LOCAL_ONLY_DIRS=

# ============================== LÍMITES ==============================
# Tamaño máximo por archivo y total por llamada (bytes)
ALLAGENTS_MAX_FILE_BYTES=2000000
ALLAGENTS_MAX_TOTAL_BYTES=6000000
# Recorta respuestas largas para no llenar el contexto de Claude
ALLAGENTS_MAX_OUTPUT_CHARS=20000
# Tiempo máximo por llamada (segundos)
ALLAGENTS_TIMEOUT_S=300
